<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HistoricalImporterTool</RootNamespace>
    <AssemblyName>HistoricalImporterTool</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MarketCore.HistoricalImporter\MarketCore.HistoricalImporter.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\ProfitDLL64.dll" Condition="Exists('..\ProfitDLL64.dll')">
      <Link>ProfitDLL64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
