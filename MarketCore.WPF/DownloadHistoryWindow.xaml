<Window x:Class="MarketCore.WPF.DownloadHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Baixar histórico — escolha o ativo abaixo"
        Height="500" Width="480"
        MinHeight="460" MinWidth="440"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#0D0D0D"
        FontFamily="Consolas">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Ativo no topo para não falhar ao ver (build antigo sem este bloco só tinha datas + pasta). -->
        <TextBlock Grid.Row="0" Text="Ativo (ticker, ex.: WINFUT ou WINM26)"
                   Foreground="#CCCCCC" Margin="0,0,0,4"
                   TextWrapping="Wrap"/>
        <TextBox x:Name="TxTicker" Grid.Row="1" Height="28" Margin="0,0,0,14" VerticalContentAlignment="Center"
                 Background="#1A1A1A" Foreground="#E8E8E8" BorderBrush="#2A2A2A" CaretBrush="#E8E8E8"
                 ToolTip="Código na bolsa. Mini índice: WINFUT (contínuo) ou WIN + vencimento."/>

        <TextBlock Grid.Row="2" Text="Datas (pregão)"
                   Foreground="#CCCCCC" Margin="0,0,0,8"
                   TextWrapping="Wrap"/>
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="De" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                <DatePicker x:Name="DpStart" Background="#1A1A1A" Foreground="#E8E8E8"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Até" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                <DatePicker x:Name="DpEnd" Background="#1A1A1A" Foreground="#E8E8E8"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="4" Text="Guardar CSV em"
                   Foreground="#CCCCCC" Margin="0,0,0,6"/>
        <Grid Grid.Row="5" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxFolder" Grid.Column="0" Height="26" VerticalContentAlignment="Center"
                     Background="#1A1A1A" Foreground="#E8E8E8" BorderBrush="#2A2A2A" CaretBrush="#E8E8E8"/>
            <Button x:Name="BtnBrowse" Grid.Column="2" Content="…" Width="36" Height="26"
                    Cursor="Hand" Background="#1E2A1E" Foreground="#00C853" BorderBrush="#00C853"
                    Click="BtnBrowse_Click"/>
        </Grid>

        <Border Grid.Row="6" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120">
                <TextBlock x:Name="TbProgress" TextWrapping="Wrap" FontSize="11" Foreground="#AAAAAA"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="7">
            <CheckBox x:Name="CkStartup" Content="Ao abrir o MarketCore, mostrar esta janela"
                      Foreground="#E0E0E0" Margin="0,0,0,10"
                      Checked="CkStartup_Changed" Unchecked="CkStartup_Changed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnDownload" Content="Baixar"
                        MinWidth="110" Height="30" Margin="0,0,8,0" Cursor="Hand"
                        Background="#1E2A1E" Foreground="#00C853" BorderBrush="#00C853"
                        Click="BtnDownload_Click"/>
                <Button x:Name="BtnClose" Content="Fechar"
                        MinWidth="80" Height="30" Cursor="Hand"
                        Background="#2A2A2A" Foreground="#CCCCCC" BorderBrush="#444444"
                        Click="BtnClose_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
