<Window x:Class="MarketCore.WPF.LeituraFluxo.LeituraFluxoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MarketCore - Leitura de Fluxo"
        Width="1700" Height="920"
        MinWidth="1200" MinHeight="650"
        Background="#060A12"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>

        <SolidColorBrush x:Key="AccentGreen"  Color="#00FF88"/>
        <SolidColorBrush x:Key="AccentBlue"   Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentYellow" Color="#FBBF24"/>
        <SolidColorBrush x:Key="AccentRed"    Color="#FF4466"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#A78BFA"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FB923C"/>
        <SolidColorBrush x:Key="AccentTeal"   Color="#22D3EE"/>
        <SolidColorBrush x:Key="AccentPink"   Color="#F472B6"/>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background"      Value="#0D1421"/>
            <Setter Property="BorderBrush"     Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="Margin"          Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>

        <!-- ComboBox escuro (corretora por coluna) -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#0A0F1A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A3A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="18"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           Foreground="White"
                                                           FontFamily="Consolas"
                                                           FontWeight="Bold"
                                                           Margin="6,3"
                                                           VerticalAlignment="Center"/>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="#94A3B8"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#0D1421" BorderBrush="#2A3A4A" BorderThickness="1" CornerRadius="4"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#0D1421"/>
            <Setter Property="Padding" Value="8,5"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#00FF88"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="170"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="MARKETCORE - LEITURA DE FLUXO" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="#00FF88"/>
                    <TextBlock Text="Captura ao vivo de Times &amp; Trades + padrões de execução por corretora" FontFamily="Consolas" FontSize="11" Foreground="#FFFFFF"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#00FF88" Margin="0,0,6,0">
                        <Ellipse.Effect><DropShadowEffect Color="#00FF88" BlurRadius="6" ShadowDepth="0"/></Ellipse.Effect>
                    </Ellipse>
                    <TextBlock x:Name="StatusLabel" Text="CAPTURANDO" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#00FF88" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="negócios: " FontFamily="Consolas" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TbTradeCount" Text="0" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="ClockLabel" Grid.Column="2" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- AGRESSÃO POR QUANTIDADE EXECUTADA -->
        <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}" Text="▸ AGRESSÃO POR QUANTIDADE EXECUTADA" Foreground="{StaticResource AccentBlue}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Janela 1 -->
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="QTD (lotes)" FontFamily="Consolas" FontSize="10" Foreground="#FFFFFF"/>
                            <TextBox x:Name="TxQty1" Text="1000" FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                     Background="#0A0F1A" Foreground="#FFFFFF" BorderBrush="#2A3A4A" BorderThickness="1" Padding="4,2"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                            <Grid Height="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="BuyCol1" Width="50*"/>
                                    <ColumnDefinition x:Name="SellCol1" Width="50*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource AccentGreen}" CornerRadius="3,0,0,3"/>
                                <Border Grid.Column="1" Background="{StaticResource AccentRed}" CornerRadius="0,3,3,0"/>
                                <TextBlock x:Name="TbBuyPct1" Grid.Column="0" Text="50%" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#04220F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbSellPct1" Grid.Column="1" Text="50%" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#2A0006" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="TbQtyReal1" Text="0 de 1000 lotes" FontFamily="Consolas" FontSize="10" Foreground="#FFFFFF" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="PONTOS MOVIDOS" FontFamily="Consolas" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TbPoints1" Text="+0 pts" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <!-- Janela 2 -->
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="QTD (lotes)" FontFamily="Consolas" FontSize="10" Foreground="#FFFFFF"/>
                            <TextBox x:Name="TxQty2" Text="5000" FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                     Background="#0A0F1A" Foreground="#FFFFFF" BorderBrush="#2A3A4A" BorderThickness="1" Padding="4,2"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                            <Grid Height="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="BuyCol2" Width="50*"/>
                                    <ColumnDefinition x:Name="SellCol2" Width="50*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource AccentGreen}" CornerRadius="3,0,0,3"/>
                                <Border Grid.Column="1" Background="{StaticResource AccentRed}" CornerRadius="0,3,3,0"/>
                                <TextBlock x:Name="TbBuyPct2" Grid.Column="0" Text="50%" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#04220F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbSellPct2" Grid.Column="1" Text="50%" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#2A0006" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="TbQtyReal2" Text="0 de 5000 lotes" FontFamily="Consolas" FontSize="10" Foreground="#FFFFFF" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="PONTOS MOVIDOS" FontFamily="Consolas" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TbPoints2" Text="+0 pts" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <!-- Janela 3 -->
                    <Grid Grid.Column="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="QTD (lotes)" FontFamily="Consolas" FontSize="10" Foreground="#FFFFFF"/>
                            <TextBox x:Name="TxQty3" Text="20000" FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                     Background="#0A0F1A" Foreground="#FFFFFF" BorderBrush="#2A3A4A" BorderThickness="1" Padding="4,2"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                            <Grid Height="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="BuyCol3" Width="50*"/>
                                    <ColumnDefinition x:Name="SellCol3" Width="50*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource AccentGreen}" CornerRadius="3,0,0,3"/>
                                <Border Grid.Column="1" Background="{StaticResource AccentRed}" CornerRadius="0,3,3,0"/>
                                <TextBlock x:Name="TbBuyPct3" Grid.Column="0" Text="50%" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#04220F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbSellPct3" Grid.Column="1" Text="50%" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#2A0006" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="TbQtyReal3" Text="0 de 20000 lotes" FontFamily="Consolas" FontSize="10" Foreground="#FFFFFF" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="PONTOS MOVIDOS" FontFamily="Consolas" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TbPoints3" Text="+0 pts" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- PADRÕES DE EXECUÇÃO POR CORRETORA - 7 colunas -->
        <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource SectionLabel}" Text="▸ PADRÕES DE EXECUÇÃO POR CORRETORA" Foreground="{StaticResource AccentPurple}"/>
                <ScrollViewer x:Name="ColumnsScrollHost" Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                    <!-- Width preso à largura real do viewport: sem isso, o UniformGrid mede seus filhos com
                         largura infinita antes de decidir o tamanho da célula, o texto dos padrões nunca quebra
                         linha nessa medição, e cada coluna acaba larga o suficiente pra caber a frase inteira —
                         é por isso que só cabiam 3 de 7 corretoras mesmo com a janela maximizada. Com Width
                         preso ao ScrollViewer, as 7 colunas dividem a largura real disponível (esticando ao
                         maximizar) e só voltam a rolar se a janela ficar mais estreita que MinWidth. -->
                    <UniformGrid x:Name="ColumnsHost" Rows="1" Columns="7" MinWidth="1660"
                                 Width="{Binding ActualWidth, ElementName=ColumnsScrollHost}"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- PRÓXIMAS EXECUÇÕES PREVISTAS - resumo consolidado das 7 colunas, ordenado pelo horário mais próximo -->
        <Border Grid.Row="3" Style="{StaticResource PanelStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource SectionLabel}" Text="▸ PRÓXIMAS EXECUÇÕES PREVISTAS" Foreground="{StaticResource AccentYellow}"/>
                <ScrollViewer Grid.Row="1" x:Name="NextExecScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="NextExecList"/>
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>
</Window>
