<Window x:Class="MarketCore.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MarketCore.WPF"
        xmlns:fs="clr-namespace:MarketCore.FlowSense"
        mc:Ignorable="d"
        Title="MarketCore FlowSense"
        Height="900" Width="1500"
        MinHeight="700" MinWidth="900"
        Background="#0D0D0D"
        FontFamily="Consolas">
    <Window.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#0D0D0D"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#141414"/>
        <SolidColorBrush x:Key="BgTertiary" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00C853"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF1744"/>
        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00C853"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#00C853"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DarkInput" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="CaretBrush" Value="#E8E8E8"/>
        </Style>
        <!-- Ticker principal: editável; Enter ou perda de foco aplica subscrição -->
        <Style x:Key="HeaderTickerInput" TargetType="TextBox" BasedOn="{StaticResource DarkInput}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="MaxWidth" Value="160"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#1E2A1E"/>
            <Setter Property="Foreground" Value="#00C853"/>
            <Setter Property="BorderBrush" Value="#00C853"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00C853"/>
                    <Setter Property="Foreground" Value="#0D0D0D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#2A1010"/>
            <Setter Property="Foreground" Value="#FF4444"/>
            <Setter Property="BorderBrush" Value="#FF4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="HSep" TargetType="Separator">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="HiddenScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ══ -->
        <Border Grid.Row="0" Background="#0A0A0A" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxPrimaryTicker" Style="{StaticResource HeaderTickerInput}"
                         Text="WINQ26"
                         ToolTip="Código do ativo (ex.: WINFUT, WINQ26, PETR4). Enter ou clique fora para monitorizar em todo o FlowSense."/>
                <TextBlock Grid.Column="1" x:Name="TbLastPrice" Text="128.440" FontSize="14" FontWeight="Bold" Foreground="#00C853" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Botões de ação -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="BtnAgentPanel" Width="22" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Abrir Leitura de Fluxo" Margin="0,0,4,0">
                        <Viewbox Width="15" Height="15">
                            <Canvas Width="24" Height="24">
                                <Line X1="12" Y1="2" X2="12" Y2="5" Stroke="#00FF88" StrokeThickness="1.5"/>
                                <Ellipse Canvas.Left="10.5" Canvas.Top="1" Width="3" Height="3" Fill="#00FF88"/>
                                <Rectangle Canvas.Left="4" Canvas.Top="5" Width="16" Height="11" RadiusX="3" RadiusY="3" Fill="#1E2A1E" Stroke="#00FF88" StrokeThickness="1.5"/>
                                <Ellipse Canvas.Left="7" Canvas.Top="8" Width="3" Height="3" Fill="#00FF88"/>
                                <Ellipse Canvas.Left="14" Canvas.Top="8" Width="3" Height="3" Fill="#00FF88"/>
                                <Rectangle Canvas.Left="8" Canvas.Top="13" Width="8" Height="1.5" RadiusX="1" RadiusY="1" Fill="#00FF88"/>
                                <Rectangle Canvas.Left="6" Canvas.Top="16" Width="12" Height="6" RadiusX="2" RadiusY="2" Fill="#1E2A1E" Stroke="#00FF88" StrokeThickness="1.5"/>
                                <Rectangle Canvas.Left="2" Canvas.Top="17" Width="4" Height="3" RadiusX="1" RadiusY="1" Fill="#1E2A1E" Stroke="#00FF88" StrokeThickness="1.2"/>
                                <Rectangle Canvas.Left="18" Canvas.Top="17" Width="4" Height="3" RadiusX="1" RadiusY="1" Fill="#1E2A1E" Stroke="#00FF88" StrokeThickness="1.2"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="BtnHistory" Width="22" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Baixar histórico WIN (CSV por contrato)" Visibility="Collapsed" Margin="0,0,4,0">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="#00BCD4" StrokeThickness="1.6" StrokeLineJoin="Round" Data="M6,4 L6,20 M4,7 L8,7 M4,12 L8,12 M4,17 L8,12"/>
                                <Path Stroke="#00BCD4" StrokeThickness="1.6" Data="M12,6 L14,4 L20,4 L20,20 L12,20 Z M12,10 L18,10 M12,14 L18,14 M12,18 L16,18"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="BtnRecordingConfig" Width="22" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Configurar caminho de gravação" Margin="0,0,4,0">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#4488FF" Data="M2,6 L8,6 L10,4 L22,4 L22,18 L2,18 Z"/>
                                <Path Fill="#2266CC" Data="M2,8 L22,8 L22,18 L2,18 Z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="BtnAnaliseQuant" Width="22" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Análise Quantitativa" Margin="0,0,4,0">
                        <Viewbox Width="15" Height="15">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="2" Canvas.Top="14" Width="4" Height="8" Fill="#00BCD4"/>
                                <Rectangle Canvas.Left="8" Canvas.Top="9"  Width="4" Height="13" Fill="#00BCD4"/>
                                <Rectangle Canvas.Left="14" Canvas.Top="5" Width="4" Height="17" Fill="#00BCD4"/>
                                <Rectangle Canvas.Left="20" Canvas.Top="2" Width="4" Height="20" Fill="#00C853"/>
                                <Polyline Points="4,13 10,8 16,4 22,1" Stroke="#FFD600" StrokeThickness="1.5" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="BtnPregaoVivaVoz" Width="22" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Pregão Viva Voz" Margin="0,0,4,0">
                        <Viewbox Width="15" Height="15">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="9" Canvas.Top="2" Width="6" Height="10" RadiusX="3" RadiusY="3" Fill="#FF8C00"/>
                                <Path Stroke="#FF8C00" StrokeThickness="1.5" Fill="Transparent" Data="M6,12 A6,6 0 0 0 18,12"/>
                                <Line X1="12" Y1="18" X2="12" Y2="21" Stroke="#FF8C00" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="8" Y1="21" X2="16" Y2="21" Stroke="#FF8C00" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="BtnPower" Width="22" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Encerrar MarketCore">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="#CC3333" StrokeThickness="2.2" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 7,5 A 8.5,8.5 0 1 0 17,5"/>
                                <Line X1="12" Y1="1.5" X2="12" Y2="10" Stroke="#CC3333" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <!-- Indicadores (só Exaustão + Delta) -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Background="#1A2A1A" BorderBrush="#2A4A2A" BorderThickness="1" CornerRadius="3" Padding="6,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="E:" FontSize="11" FontWeight="Bold" Foreground="#AAAAAA"/>
                            <TextBlock x:Name="TbExhaustionCount" Text="0" FontSize="12" FontWeight="Bold" Foreground="#FFD600"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Grid.Column="5" Background="#0A1A0A" BorderBrush="#1A3A1A" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Δ " FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbDelta" Text="+0" FontSize="13" FontWeight="Bold" Foreground="#00C853" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse x:Name="EllipseConnection" Width="8" Height="8" Fill="#FF1744" Margin="0,0,5,0"/>
                    <TextBlock x:Name="TbConnectionStatus" Text="DESCONECTADO" FontSize="10" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="7" x:Name="TbClock" Text="--:--:--" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══ ÁREA PRINCIPAL — só Chart + FlowScore (book/tape/alertas removidos) ══ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="500"/>
            </Grid.RowDefinitions>
            <local:FlowCandleChart x:Name="flowCandleChart" Grid.Row="0"/>
            <Border Grid.Row="1" Background="#0A0A0A" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" x:Name="PainelInferiorGrafico">
                <fs:FlowScorePanel x:Name="FlowScorePanelControl"/>
            </Border>
        </Grid>

        <!-- ══ STATUS BAR ══ -->
        <Border Grid.Row="2" Background="#080808" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Trades:" FontSize="10" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TbTradeCount" Foreground="#EEEEEE" FontSize="10" Text="0" VerticalAlignment="Center" Margin="3,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Gravando:" FontSize="10" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                    <Ellipse x:Name="EllipseRecording" Width="7" Height="7" Fill="#333333" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TbRecordingStatus" Foreground="#EEEEEE" FontSize="10" Text="OFF" VerticalAlignment="Center" Margin="3,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <TextBlock Text="Replay:" FontSize="10" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TbReplayStatus" Foreground="#EEEEEE" FontSize="10" Text="--" VerticalAlignment="Center" Margin="3,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Relógio:" FontSize="10" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbDataLatency" FontSize="10" Foreground="#EEEEEE" VerticalAlignment="Center" Margin="6,0,0,0" FontFamily="Consolas" Text="--" ToolTip="Negócio = hora vinda da DLL (quando há data). DLL→motor = fila/processador Profit. motor→HUD = até este frame da UI (~33 ms). PC = relógio local agora." TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="TbDiskAlert" Text="" FontSize="9" Foreground="#FF1744" VerticalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
                <TextBlock Grid.Column="8" Text="MarketCore FlowSense v4.0 • Modo Análise pt-BR" FontSize="10" Foreground="#888888" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
