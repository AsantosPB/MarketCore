<Window x:Class="MarketCore.WPF.Views.PregaoVivaVoz.PregaoVivaVozWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MarketCore.WPF.Views.PregaoVivaVoz"
        mc:Ignorable="d"
        Title="Pregão Viva Voz - MarketCore FlowSense"
        Height="850" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="#0d1117">
    
    <Window.Resources>
        <SolidColorBrush x:Key="BgBase" Color="#0d1117"/>
        <SolidColorBrush x:Key="BgCard" Color="#161b22"/>
        <SolidColorBrush x:Key="BgInput" Color="#0d1117"/>
        <SolidColorBrush x:Key="Border" Color="#30363d"/>
        <SolidColorBrush x:Key="BorderLight" Color="#21262d"/>
        <SolidColorBrush x:Key="Text" Color="#e6edf3"/>
        <SolidColorBrush x:Key="TextMuted" Color="#7d8590"/>
        <SolidColorBrush x:Key="TextDim" Color="#6e7681"/>
        <SolidColorBrush x:Key="Green" Color="#3fb950"/>
        <SolidColorBrush x:Key="Blue" Color="#58a6ff"/>
        <SolidColorBrush x:Key="Orange" Color="#d29922"/>
        <SolidColorBrush x:Key="Purple" Color="#a371f7"/>
        <SolidColorBrush x:Key="Red" Color="#ff4444"/>
        <SolidColorBrush x:Key="Cyan" Color="#39d0d8"/>
        <SolidColorBrush x:Key="GreenBg" Color="#033a16"/>
        
        <Style x:Key="CardBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        
        <Style x:Key="BoxTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1c2128"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="BtnSalvar" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource Green}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style x:Key="BtnStudio" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource Red}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style x:Key="BtnMotor" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource Cyan}"/>
            <Setter Property="Foreground" Value="#0d1117"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        
        <Style x:Key="BtnSimulador" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource Purple}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="NumInput" TargetType="TextBox" BasedOn="{StaticResource InputStyle}">
            <Setter Property="Width" Value="60"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="PlayerPill" TargetType="ToggleButton">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="pillBorder"
                                Background="{StaticResource BgInput}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="0.5"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="{StaticResource GreenBg}"/>
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="{StaticResource Green}"/>
                                <Setter Property="Foreground" Value="{StaticResource Green}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="{StaticResource Blue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="TableHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        
        <Style x:Key="TableCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- ============ CABEÇALHO ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="🎙️ Pregão Viva Voz" FontSize="18" FontWeight="Medium" Foreground="#ff7b72"/>
                <TextBlock Text="{Binding ResumoPlayers}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,15,0" VerticalAlignment="Center">
                    <TextBlock Text="🔊" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Slider Width="80" Minimum="0" Maximum="100" Value="{Binding VolumeMaster}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding VolumeMaster}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="%" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
                
                <Button Style="{StaticResource BtnStudio}" Content="🎙️ Studio de Gravação" Command="{Binding AbrirStudioCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource BtnBase}" Content="{Binding TextoBotaoPausar}" Command="{Binding PausarRetomarCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource BtnSalvar}" Content="💾 Salvar" Command="{Binding SalvarCommand}"/>
            </StackPanel>
        </Grid>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>
                
                <!-- ============ NOVO BLOCO: CONTROLE DO MOTOR ============ -->
                <Border Style="{StaticResource CardBox}" BorderThickness="3,0.5,0.5,0.5" BorderBrush="{StaticResource Cyan}">
                    <StackPanel>
                        <TextBlock Text="⚡ Motor de Detecção + Simulador de Testes" Foreground="{StaticResource Cyan}" Style="{StaticResource BoxTitle}"/>
                        
                        <!-- Controles do motor -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0" 
                                    Style="{StaticResource BtnMotor}" 
                                    Content="{Binding TextoBotaoMotor}" 
                                    Command="{Binding ToggleMotorCommand}" 
                                    Margin="0,0,8,0"
                                    Padding="14,8"/>
                            
                            <Button Grid.Column="1"
                                    Style="{StaticResource BtnSimulador}"
                                    Content="{Binding TextoBotaoSimulador}"
                                    Command="{Binding ToggleSimuladorCommand}"
                                    IsEnabled="{Binding SimuladorDisponivel}"
                                    ToolTip="Desativado quando o MarketCore está em modo mercado real (ProfitDLL ativa)."
                                    Margin="0,0,8,0"
                                    Padding="14,8"/>
                            
                            <Button Grid.Column="2"
                                    Style="{StaticResource BtnBase}" 
                                    Content="🗑 Limpar log" 
                                    Command="{Binding LimparLogCommand}"
                                    Padding="10,8"/>
                            
                            <TextBlock Grid.Column="3" 
                                       Text="{Binding StatusMotor}" 
                                       FontSize="12" 
                                       FontWeight="Medium"
                                       Foreground="{StaticResource Cyan}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Estatísticas em tempo real -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,5,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="EVENTOS PROCESSADOS" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding EventosProcessados}" FontSize="22" FontWeight="Medium" Foreground="{StaticResource Blue}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="2,0,2,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="EVENTOS NARRADOS" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding EventosNarrados}" FontSize="22" FontWeight="Medium" Foreground="{StaticResource Green}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="5,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="RAJADAS DETECTADAS" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding RajadasDetectadas}" FontSize="22" FontWeight="Medium" Foreground="{StaticResource Purple}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <!-- Log de eventos -->
                        <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource Border}" BorderThickness="0.5" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="📜 LOG DE EVENTOS (tempo real)" FontSize="9" Foreground="{StaticResource TextMuted}" Padding="8,5,5,3"/>
                                <Border Height="180" ClipToBounds="True">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding LogEventos}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" 
                                                               FontFamily="Consolas" 
                                                               FontSize="11" 
                                                               Foreground="{StaticResource Text}"
                                                               Padding="8,2"
                                                               TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- ============ BLOCO 1: PLAYERS MONITORADOS ============ -->
                <Border Style="{StaticResource CardBox}" BorderThickness="3,0.5,0.5,0.5" BorderBrush="{StaticResource Green}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🟢 Players que estou monitorando" Foreground="{StaticResource Green}" Style="{StaticResource BoxTitle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumoPlayers}" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        </Grid>
                        
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Players}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource PlayerPill}" IsChecked="{Binding AtivoHoje}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Bandeira}" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Nome}"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                
                <!-- ============ BLOCO 2: FILTROS DO BOOK ============ -->
                <Border Style="{StaticResource CardBox}" BorderThickness="3,0.5,0.5,0.5" BorderBrush="{StaticResource Blue}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔵 Filtros do BOOK · quando COLOCAR ordem" Foreground="{StaticResource Blue}" Style="{StaticResource BoxTitle}"/>
                            <TextBox Grid.Column="1" Width="130" Style="{StaticResource InputStyle}" Text="{Binding BuscaBook, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        
                        <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,0.5" CornerRadius="4,4,0,0" Padding="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="" Style="{StaticResource TableHeader}"/>
                                <TextBlock Grid.Column="1" Text="PLAYER" Style="{StaticResource TableHeader}"/>
                                <TextBlock Grid.Column="2" Text="▲ COMPRA ≥" HorizontalAlignment="Center" Foreground="{StaticResource Green}" Style="{StaticResource TableHeader}"/>
                                <TextBlock Grid.Column="3" Text="▼ VENDA ≥" HorizontalAlignment="Center" Foreground="{StaticResource Red}" Style="{StaticResource TableHeader}"/>
                                <TextBlock Grid.Column="4" Text="⚡ PRIORIDADE ≥" HorizontalAlignment="Center" Foreground="{StaticResource Orange}" Style="{StaticResource TableHeader}"/>
                                <TextBlock Grid.Column="5" Text="ON" HorizontalAlignment="Center" Style="{StaticResource TableHeader}"/>
                            </Grid>
                        </Border>

                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PlayersBookFiltrados}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,0.5" Padding="0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Bandeira}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Nome}" Style="{StaticResource TableCell}" FontWeight="Medium"/>
                                                <TextBox Grid.Column="2" Style="{StaticResource NumInput}" Text="{Binding Book.CompraMinima, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Grid.Column="3" Style="{StaticResource NumInput}" Text="{Binding Book.VendaMinima, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Grid.Column="4" Style="{StaticResource NumInput}" Width="80"
                                                         Text="{Binding Book.PrioridadeMinimaTexto, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="Vazio = sem prioridade. Valor inteiro = quando oferta ≥ este número (níveis 1–4), interrompe áudio atual e narra imediatamente."/>
                                                <CheckBox Grid.Column="5" IsChecked="{Binding Book.Ativo}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- ============ BLOCO 3: FILTROS DE AGRESSÃO ============ -->
                <Border Style="{StaticResource CardBox}" BorderThickness="3,0.5,0.5,0.5" BorderBrush="{StaticResource Orange}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🟠 Filtros de AGRESSÃO · quando TOMAR ou BATER" Foreground="{StaticResource Orange}" Style="{StaticResource BoxTitle}"/>
                            <TextBox Grid.Column="1" Width="130" Style="{StaticResource InputStyle}" Text="{Binding BuscaAgressao, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        
                        <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,0.5" CornerRadius="4,4,0,0" Padding="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="" Style="{StaticResource TableHeader}"/>
                                <TextBlock Grid.Column="1" Text="PLAYER" Style="{StaticResource TableHeader}"/>
                                <TextBlock Grid.Column="2" Text="▲ TOMOU ≥" HorizontalAlignment="Center" Foreground="{StaticResource Green}" Style="{StaticResource TableHeader}"/>
                                <TextBlock Grid.Column="3" Text="▼ BATEU ≥" HorizontalAlignment="Center" Foreground="{StaticResource Red}" Style="{StaticResource TableHeader}"/>
                                <TextBlock Grid.Column="4" Text="ON" HorizontalAlignment="Center" Style="{StaticResource TableHeader}"/>
                            </Grid>
                        </Border>
                        
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PlayersAgressaoFiltrados}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,0.5" Padding="0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Bandeira}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Nome}" Style="{StaticResource TableCell}" FontWeight="Medium"/>
                                                <TextBox Grid.Column="2" Style="{StaticResource NumInput}" Text="{Binding Agressao.TomouMinimo, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Grid.Column="3" Style="{StaticResource NumInput}" Text="{Binding Agressao.BateuMinimo, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox Grid.Column="4" IsChecked="{Binding Agressao.Ativo}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                
                <!-- ============ BLOCO 4: FILTROS DE RAJADA ============ -->
                <Border Style="{StaticResource CardBox}" BorderThickness="3,0.5,0.5,0.5" BorderBrush="{StaticResource Purple}">
                    <StackPanel>
                        <TextBlock Text="🟣 Filtros de RAJADA · sequência de agressões em milissegundos" Foreground="{StaticResource Purple}" Style="{StaticResource BoxTitle}"/>
                        
                        <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0.5" CornerRadius="5" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="SEQUÊNCIA" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                    <TextBox Style="{StaticResource NumInput}" Text="{Binding ConfigRajada.SequenciaMinima, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="agressões" FontSize="9" Foreground="{StaticResource Purple}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="EM ATÉ" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                    <TextBox Style="{StaticResource NumInput}" Text="{Binding ConfigRajada.JanelaMilissegundos, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="milissegundos" FontSize="9" Foreground="{StaticResource Purple}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="PAROU APÓS" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                    <TextBox Style="{StaticResource NumInput}" Text="{Binding ConfigRajada.SilencioParouMilissegundos, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="ms sem agir" FontSize="9" Foreground="{StaticResource Purple}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,0.5" CornerRadius="4,4,0,0" Padding="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="" Style="{StaticResource TableHeader}"/>
                                <TextBlock Grid.Column="1" Text="PLAYER ENTRA NA RAJADA?" Style="{StaticResource TableHeader}"/>
                                <TextBlock Grid.Column="2" Text="VOL ≥" HorizontalAlignment="Center" Foreground="{StaticResource Purple}" Style="{StaticResource TableHeader}"/>
                                <TextBlock Grid.Column="3" Text="SIM/NÃO" HorizontalAlignment="Center" Style="{StaticResource TableHeader}"/>
                            </Grid>
                        </Border>

                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Players}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,0.5" Padding="0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Bandeira}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Nome}" Style="{StaticResource TableCell}" FontWeight="Medium"/>
                                                <TextBox Grid.Column="2" Style="{StaticResource NumInput}" Text="{Binding Rajada.VolumeMinimo, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox Grid.Column="3" IsChecked="{Binding Rajada.Participa}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
        
        <!-- ============ BARRA DE STATUS ============ -->
        <Border Grid.Row="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}" BorderThickness="0,0.5,0,0" Padding="10,6" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText" Text="Pregão Viva Voz carregado. ZIP 2 — Motor + Simulador prontos." FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="MarketCore FlowSense v1.0 · ZIP 2" FontSize="10" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
