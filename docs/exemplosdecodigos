                        case "get accounts broker":
                            DoGetAccountsByBroker();
                            break;
                        case "get agent name":
                            WriteSync("Nome do agente: " + DoGetAgentName());
                            break;
                        case "get position asset":
                            getPositionAssets();
                            break;
                        case "get order":
                            DoGetOrder();
                            break;
                        case "exit":
                            terminate = true;
                            break;
                        default:
                            break;
                    }
                }
            }
            catch (Exception ex)
            {
                WriteSync(ex.Message);
            }
        }

    }

