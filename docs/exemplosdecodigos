                        case "unsubscribe price depth":
                            DoUnsubscribePriceDepth();
                            break;
                        case "offerbook":
                            DoSubscribeOfferBook();
                            break;
                        case "request history":
                            RequestHistory();
                            break;
                        case "request order":
                            RequestOrder();
                            break;
                        case "get position":
